// tinytalks.live — database schema
// Targets Neon Postgres. `DATABASE_URL` should be Neon's pooled
// connection string (the one with "-pooler" in the hostname) — Neon's
// own connection pooling in front of Postgres is what makes a plain
// PrismaClient safe to use from Vercel's serverless functions, without
// needing Prisma's separate (and, as of 5.x, preview-only) driver
// adapter machinery.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AccountType {
  GUEST
  REGULAR
  ADMIN
}

enum GenderClaim {
  MALE
  FEMALE
  NONBINARY
  UNSPECIFIED
}

enum VerificationStatus {
  NONE
  PENDING
  APPROVED
  REJECTED
}

enum TicketStatus {
  OPEN
  IN_REVIEW
  RESOLVED
  DISMISSED
}

enum TicketCategory {
  HARASSMENT_OR_ABUSE
  UNDERAGE_SUSPICION
  NUDITY_OR_SEXUAL_CONTENT
  SPAM_OR_SCAM
  IMPERSONATION_OR_FAKE_PROFILE
  GENDER_MISREPRESENTATION
  THREATS_OR_VIOLENCE
  HATE_SPEECH
  OTHER
}

enum ImageViewMode {
  TIMED_10S
  ONE_TIME
}

enum FriendStatus {
  PENDING
  ACCEPTED
}

model User {
  id                   String              @id @default(uuid())
  accountType          AccountType         @default(GUEST)
  email                String?             @unique
  passwordHash         String?
  displayName          String?

  ageConfirmed         Boolean             @default(false) // self-attested 18+ checkbox, required for ALL accounts
  ageConfirmedAt       DateTime?

  genderClaimed        GenderClaim         @default(UNSPECIFIED)
  genderPhotoPath      String?             // selfie submitted for admin gender review
  genderVerification   VerificationStatus  @default(NONE)
  genderReviewedBy     String?
  genderReviewedAt     DateTime?

  // "image-verified" flag — required before ANY account (guest or regular)
  // can send/receive images. Requires BOTH email OTP success AND a passed
  // facial age-estimation check (see lib/ageEstimation.js). No government
  // ID is ever collected or stored for this.
  otpVerified          Boolean             @default(false)
  ageEstimationPassed  Boolean             @default(false)
  ageEstimationScore   Float?              // vendor confidence, informational only
  imageVerifiedAt      DateTime?

  premiumGenderFilter  Boolean             @default(false)

  // Self-reported location tags (town/district/state, e.g. "Trivandrum",
  // "Kerala") used to prefer nearby matches in the queue — never derived
  // from IP/GPS, since this app deliberately collects no such data.
  locationTags         String[]            @default([])
  // Self-reported general interests (topics, hobbies) — same matching
  // treatment as locationTags: a soft preference, never a hard filter.
  interests            String[]            @default([])
  // When true, accepted friends can no longer see this user's interests
  // via GET /friends (see routes/friends.js shape()) — interests are
  // still used for queue matching either way, since matching is
  // server-side and never exposes them to the other party directly.
  // Default false: visible to friends unless the user opts out.
  interestsPrivate     Boolean             @default(false)

  avatarUrl               String?
  // Rolling 24h rate limits on profile edits (mirrors the "N changes left
  // today" pattern common to social apps) — see lib/dailyLimit.js.
  avatarChangeCount       Int               @default(0)
  avatarChangeWindowStart DateTime?
  nameChangeCount         Int               @default(0)
  nameChangeWindowStart   DateTime?

  banned               Boolean             @default(false)
  bannedAt             DateTime?
  banReason            String?

  // Admin-only activity tracking (see server/src/middleware/auth.js and
  // routes/admin.js) — NOT used for matching or shown to other users, only
  // to admins via the dashboard's active-user count and each user's IP
  // log. lastIp/lastSeenAt are a cheap denormalized "most recent" pair,
  // throttled to update at most every few minutes per user; the full
  // history of distinct IPs seen lives in IpLog below.
  lastIp               String?
  lastSeenAt           DateTime?
  // Best-effort reverse-IP geolocation (e.g. "Bengaluru, Karnataka, IN") —
  // approximate at best, and null whenever the lookup fails, is skipped
  // for a private/local address, or hasn't run yet. See
  // middleware/auth.js's lookupIpLocation. NOT derived from GPS/browser
  // geolocation — that would require an explicit permission prompt to the
  // visitor, which this silent, admin-only log deliberately avoids.
  lastLocation         String?
  // Raw User-Agent string from the most recent request that updated
  // lastIp/lastSeenAt above (same throttling — not stamped on every
  // request). Kept raw rather than pre-parsed; lib/userAgent.js's
  // parseUserAgent turns it into a friendly "Chrome on Android" label at
  // read time, in routes/admin.js — so a smarter parser later needs no
  // backfill, just re-reads the same stored strings.
  lastUserAgent        String?

  createdAt            DateTime            @default(now())
  expiresAt            DateTime?           // set for GUEST accounts (createdAt + 2 days)

  sentMessages         Message[]           @relation("SentMessages")
  conversationsA        Conversation[]     @relation("ParticipantA")
  conversationsB        Conversation[]     @relation("ParticipantB")
  reportsFiled         Report[]            @relation("ReportsFiled")
  reportsAgainst       Report[]            @relation("ReportsAgainst")
  otpCodes             OtpCode[]
  blocksMade           BlockedUser[]       @relation("BlockerRel")
  blocksReceived       BlockedUser[]       @relation("BlockedRel")
  reactions            MessageReaction[]
  friendRequestsSent     Friendship[]      @relation("FriendRequester")
  friendRequestsReceived Friendship[]      @relation("FriendAddressee")
  ipLogs               IpLog[]

  @@index([expiresAt])
  @@index([imageVerifiedAt])
  @@index([lastSeenAt])
}

// Admin-only history of IP addresses seen for a user — a new row is
// appended (never overwritten) each time the IP associated with a request
// changes from whichever one was last recorded, so this reads as "every
// distinct IP this account has connected from, and when", not a log of
// every single request. See middleware/auth.js requireAuth for where rows
// get written and routes/admin.js for the only route that ever reads them.
model IpLog {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ip        String
  // Same best-effort, approximate reverse-IP lookup as User.lastLocation,
  // captured at the time this row was written (an IP's geolocation can
  // drift over time as ISPs reassign blocks, so this is frozen per-entry
  // rather than re-derived later).
  location  String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

// A friend request (PENDING) that becomes a friendship (ACCEPTED). Friends
// can start a direct conversation any time via routes/friends.js
// start-chat, bypassing the random-match queue entirely — the left
// sidebar lists them separately from anonymous chat history for exactly
// that reason.
model Friendship {
  id          String       @id @default(uuid())
  requesterId String
  requester   User         @relation("FriendRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addresseeId String
  addressee   User         @relation("FriendAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)
  status      FriendStatus @default(PENDING)
  createdAt   DateTime     @default(now())

  @@unique([requesterId, addresseeId])
  @@index([addresseeId])
}

// A one-way block: blocker never gets matched with blocked again (checked
// both directions in routes/queue.js so the blocked person can't match
// back into them either). Independent of Report — blocking is self-serve
// and instant, reporting goes to admin review.
model BlockedUser {
  id        String   @id @default(uuid())
  blockerId String
  blocker   User     @relation("BlockerRel", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedId String
  blocked   User     @relation("BlockedRel", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
  @@index([blockedId])
}

// Persists independently of User so that banning a guest still blocks
// re-verification after the guest account (and its data) is purged.
model BanRecord {
  id               String   @id @default(uuid())
  identifierHash   String   @unique // sha256(normalized email or phone)
  reason           String
  category         TicketCategory?
  createdAt        DateTime @default(now())

  @@index([identifierHash])
}

// Serverless functions share no in-memory state between invocations (and
// there's no guarantee two requests even hit the same instance), so the
// matching queue that used to be an in-memory array now lives here.
// api/routes/queue.js reads/writes this table transactionally.
model WaitingQueueEntry {
  id            String       @id @default(uuid())
  userId        String       @unique
  genderClaimed GenderClaim
  desiredGender String?      // 'ANY' | a GenderClaim value | null
  canFilter     Boolean      @default(false)
  locationTags  String[]     @default([]) // denormalized copy of User.locationTags at join time
  interests     String[]     @default([]) // denormalized copy of User.interests at join time
  createdAt     DateTime     @default(now())

  @@index([createdAt])
}

model OtpCode {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash    String   // never store the raw code
  purpose     String   @default("image_verification") // or "login"
  expiresAt   DateTime
  consumedAt  DateTime?
  attempts    Int      @default(0)
  createdAt   DateTime @default(now())

  @@index([userId, purpose])
}

model Conversation {
  id             String    @id @default(uuid())
  participantAId String
  participantA   User      @relation("ParticipantA", fields: [participantAId], references: [id], onDelete: Cascade)
  participantBId String
  participantB   User      @relation("ParticipantB", fields: [participantBId], references: [id], onDelete: Cascade)
  createdAt      DateTime  @default(now())
  endedAt        DateTime?

  // Read-receipt markers — "this participant has read every message
  // created at or before this timestamp." One field per participant slot
  // (not a separate join table) since a conversation only ever has two
  // sides; routes/messages.js POST /:id/read stamps whichever one matches
  // the caller. A message is "seen" from the sender's point of view when
  // the OTHER participant's marker is >= that message's createdAt — the
  // client does that comparison, since these timestamps ride along on the
  // conversation object it already has.
  lastReadAtA    DateTime?
  lastReadAtB    DateTime?

  messages       Message[]
  reports        Report[]

  @@index([participantAId])
  @@index([participantBId])
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)

  // Plain text content, stored and readable directly by the server — this
  // app used to be end-to-end encrypted (client-side nacl.box; the server
  // only ever saw ciphertext), but that was removed: it caused permanent
  // "Could not decrypt" messages whenever a device's key rotated or a
  // second device signed in, was the source of most of this app's hardest
  // bugs, and it's since decided that admin moderation being able to read
  // reported message content matters more than the server itself being
  // unable to. Empty string for non-text kinds (image/voice), same
  // convention the old ciphertext field used; a sticker's "text" is its id
  // (e.g. "fire") and a GIF's is its CDN URL.
  text           String @default("")

  // Set when the sender edits a text message (see PATCH /messages/:id).
  editedAt       DateTime?

  kind           String       @default("text") // "text" | "image" | "sticker" | "gif" | "voice"
  image          Image?
  voiceNote      VoiceNote?

  // Optional "reply to" reference for the quote-reply feature. Nullable
  // and onDelete: SetNull (rather than Cascade) so deleting the original
  // message never cascades into deleting everything that replied to it —
  // a reply just falls back to rendering "original message unavailable"
  // client-side. The server never needs to know or store WHAT the quoted
  // text was: the client already has the original message's plaintext
  // (it's just another message in the same conversation it already
  // decrypted), so it looks the quote up locally by this id instead of
  // duplicating encrypted content.
  replyToId      String?
  replyTo        Message?     @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies        Message[]    @relation("MessageReplies")

  reactions      MessageReaction[]

  createdAt      DateTime     @default(now())

  @@index([conversationId])
  @@index([replyToId])
}

// One user's emoji reaction to one message — a single reaction per
// (message, user); reacting again with a different emoji replaces it
// rather than stacking a second one (see the upsert in routes/messages.js
// POST /:messageId/reactions), same convention most chat apps use.
// Just an emoji, no message content — the server reads and aggregates
// these directly, same as everything else now (see the note on
// Message.text above), which is what lets it send a {emoji: count}
// summary instead of every individual reaction.
model MessageReaction {
  id        String   @id @default(uuid())
  messageId String
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  emoji     String
  createdAt DateTime @default(now())

  @@unique([messageId, userId])
  @@index([messageId])
}

model Image {
  id                String        @id @default(uuid())
  messageId         String        @unique
  message           Message       @relation(fields: [messageId], references: [id], onDelete: Cascade)

  // Raw image bytes in Vercel Blob — encryption-at-rest for the storage
  // layer itself is out of scope for this MVP (Neon/Vercel Blob's own
  // infra-level protections aside); the app no longer encrypts the file
  // client-side (see the note on Message.text above), so admin moderation
  // can actually view a reported image, which the old ciphertext-blob
  // scheme never actually allowed despite the moderation route existing.
  storagePath       String
  viewMode          ImageViewMode

  uploadedAt        DateTime      @default(now())
  firstViewedAt     DateTime?
  viewedComplete    Boolean       @default(false) // true once the one-time/timed view has been consumed by the recipient

  deletedByUser     Boolean       @default(false)  // true if the recipient/sender explicitly deleted it
  deletedFromChatAt DateTime?     // soft-delete: hidden from chat UI (set by user action, or by the retention cron at +2 days)
  hardDeleteAt      DateTime?     // when the file+row will be permanently removed (immediately on user delete, else uploadedAt + 7 days)
  hardDeletedAt     DateTime?

  @@index([deletedFromChatAt])
  @@index([hardDeleteAt])
}

// A voice note (see routes/voiceNotes.js). "Erase after listening" is a
// single-consumption guarantee, so this stays single-device rather than
// readable from anywhere the recipient is signed in — fanning it out to
// every device would make "after listening" ambiguous (does the first
// device to open it erase it for the others too?). Erasure happens
// immediately the moment the
// RECIPIENT (not the sender re-checking their own sent note) finishes
// listening — see GET /:voiceNoteId/listen — rather than waiting for a
// cron sweep; hardDeleteAt is only a safety net for one that's never
// listened to at all.
model VoiceNote {
  id            String    @id @default(uuid())
  messageId     String    @unique
  message       Message   @relation(fields: [messageId], references: [id], onDelete: Cascade)

  storagePath   String        // raw audio bytes in Vercel Blob, same as Image
  durationSec   Int?          // best-effort, client-reported — just for the little duration label in the UI

  uploadedAt    DateTime  @default(now())
  // No "listened" flag: the recipient listening deletes this row outright
  // (see routes/voiceNotes.js GET /:voiceNoteId/listen) — the Message it
  // belongs to just ends up with no VoiceNote attached any more, which is
  // how the client tells "played" apart from "still waiting". This field
  // is only a safety net for one that's never listened to at all.
  hardDeleteAt  DateTime      // uploadedAt + 7 days, same window as images

  @@index([hardDeleteAt])
}

// Admin access to a not-yet-hard-deleted image is logged for accountability.
model AdminImageAccessLog {
  id         String   @id @default(uuid())
  imageId    String
  adminId    String
  reason     String?
  accessedAt DateTime @default(now())

  @@index([imageId])
}

model Report {
  id               String         @id @default(uuid())
  reporterId       String
  reporter         User           @relation("ReportsFiled", fields: [reporterId], references: [id], onDelete: Cascade)
  reportedUserId   String
  reportedUser     User           @relation("ReportsAgainst", fields: [reportedUserId], references: [id], onDelete: Cascade)
  conversationId   String?
  conversation     Conversation?  @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  category         TicketCategory
  description      String
  status           TicketStatus   @default(OPEN)

  assignedAdminId  String?
  resolutionNote   String?

  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([status])
  @@index([reportedUserId])
}
