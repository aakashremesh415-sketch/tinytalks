// tinytalks.live — database schema
// SQLite by default (free, zero external services). Swap the datasource
// to postgresql for production scale — the schema is portable.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String         @id @default(uuid())
  accountType          String         @default("GUEST")
  email                String?        @unique
  passwordHash         String?
  displayName          String?

  ageConfirmed         Boolean        @default(false)
  ageConfirmedAt       DateTime?

  genderClaimed        String         @default("UNSPECIFIED")
  genderPhotoPath      String?
  genderVerification   String         @default("NONE")
  genderReviewedBy     String?
  genderReviewedAt     DateTime?

  otpVerified          Boolean        @default(false)
  ageEstimationPassed  Boolean        @default(false)
  ageEstimationScore   Float?
  imageVerifiedAt      DateTime?

  premiumGenderFilter  Boolean        @default(false)

  banned               Boolean        @default(false)
  bannedAt             DateTime?
  banReason            String?

  createdAt            DateTime       @default(now())
  expiresAt            DateTime?

  sentMessages         Message[]      @relation("SentMessages")
  conversationsA       Conversation[] @relation("ParticipantA")
  conversationsB       Conversation[] @relation("ParticipantB")
  reportsFiled         Report[]       @relation("ReportsFiled")
  reportsAgainst       Report[]       @relation("ReportsAgainst")
  otpCodes             OtpCode[]
  publicKeys           PublicKey[]

  @@index([expiresAt])
  @@index([imageVerifiedAt])
}

model BanRecord {
  id              String   @id @default(uuid())
  identifierHash  String   @unique
  reason          String
  category        String?
  createdAt       DateTime @default(now())

  @@index([identifierHash])
}

model OtpCode {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash    String
  purpose     String    @default("image_verification")
  expiresAt   DateTime
  consumedAt  DateTime?
  attempts    Int       @default(0)
  createdAt   DateTime  @default(now())

  @@index([userId, purpose])
}

model PublicKey {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  publicKey String
  createdAt DateTime @default(now())

  @@index([userId])
}

model Conversation {
  id             String    @id @default(uuid())
  participantAId String
  participantA   User      @relation("ParticipantA", fields: [participantAId], references: [id], onDelete: Cascade)
  participantBId String
  participantB   User      @relation("ParticipantB", fields: [participantBId], references: [id], onDelete: Cascade)
  createdAt      DateTime  @default(now())
  endedAt        DateTime?

  messages       Message[]
  reports        Report[]

  @@index([participantAId])
  @@index([participantBId])
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)

  ciphertext     String
  nonce          String
  senderPubKey   String

  kind           String       @default("text")
  image          Image?

  createdAt      DateTime     @default(now())

  @@index([conversationId])
}

model Image {
  id                String    @id @default(uuid())
  messageId         String    @unique
  message           Message   @relation(fields: [messageId], references: [id], onDelete: Cascade)

  storagePath       String
  viewMode          String

  uploadedAt        DateTime  @default(now())
  firstViewedAt     DateTime?
  viewedComplete    Boolean   @default(false)

  deletedByUser     Boolean   @default(false)
  deletedFromChatAt DateTime?
  hardDeleteAt      DateTime?
  hardDeletedAt     DateTime?

  @@index([deletedFromChatAt])
  @@index([hardDeleteAt])
}

model AdminImageAccessLog {
  id         String   @id @default(uuid())
  imageId    String
  adminId    String
  reason     String?
  accessedAt DateTime @default(now())

  @@index([imageId])
}

model Report {
  id              String        @id @default(uuid())
  reporterId      String
  reporter        User          @relation("ReportsFiled", fields: [reporterId], references: [id], onDelete: Cascade)
  reportedUserId  String
  reportedUser    User          @relation("ReportsAgainst", fields: [reportedUserId], references: [id], onDelete: Cascade)
  conversationId  String?
  conversation    Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  category        String
  description     String
  status          String        @default("OPEN")

  assignedAdminId String?
  resolutionNote  String?

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([status])
  @@index([reportedUserId])
}
