// tinytalks.live — database schema
// Targets Neon Postgres. `DATABASE_URL` should be Neon's pooled
// connection string (the one with "-pooler" in the hostname) — Neon's
// own connection pooling in front of Postgres is what makes a plain
// PrismaClient safe to use from Vercel's serverless functions, without
// needing Prisma's separate (and, as of 5.x, preview-only) driver
// adapter machinery.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AccountType {
  GUEST
  REGULAR
  ADMIN
}

enum GenderClaim {
  MALE
  FEMALE
  NONBINARY
  UNSPECIFIED
}

enum VerificationStatus {
  NONE
  PENDING
  APPROVED
  REJECTED
}

enum TicketStatus {
  OPEN
  IN_REVIEW
  RESOLVED
  DISMISSED
}

enum TicketCategory {
  HARASSMENT_OR_ABUSE
  UNDERAGE_SUSPICION
  NUDITY_OR_SEXUAL_CONTENT
  SPAM_OR_SCAM
  IMPERSONATION_OR_FAKE_PROFILE
  GENDER_MISREPRESENTATION
  THREATS_OR_VIOLENCE
  HATE_SPEECH
  OTHER
}

enum ImageViewMode {
  TIMED_10S
  ONE_TIME
}

model User {
  id                   String              @id @default(uuid())
  accountType          AccountType         @default(GUEST)
  email                String?             @unique
  passwordHash         String?
  displayName          String?

  ageConfirmed         Boolean             @default(false) // self-attested 18+ checkbox, required for ALL accounts
  ageConfirmedAt       DateTime?

  genderClaimed        GenderClaim         @default(UNSPECIFIED)
  genderPhotoPath      String?             // selfie submitted for admin gender review
  genderVerification   VerificationStatus  @default(NONE)
  genderReviewedBy     String?
  genderReviewedAt     DateTime?

  // "image-verified" flag — required before ANY account (guest or regular)
  // can send/receive images. Requires BOTH email OTP success AND a passed
  // facial age-estimation check (see lib/ageEstimation.js). No government
  // ID is ever collected or stored for this.
  otpVerified          Boolean             @default(false)
  ageEstimationPassed  Boolean             @default(false)
  ageEstimationScore   Float?              // vendor confidence, informational only
  imageVerifiedAt      DateTime?

  premiumGenderFilter  Boolean             @default(false)

  banned               Boolean             @default(false)
  bannedAt             DateTime?
  banReason            String?

  createdAt            DateTime            @default(now())
  expiresAt            DateTime?           // set for GUEST accounts (createdAt + 2 days)

  sentMessages         Message[]           @relation("SentMessages")
  conversationsA        Conversation[]     @relation("ParticipantA")
  conversationsB        Conversation[]     @relation("ParticipantB")
  reportsFiled         Report[]            @relation("ReportsFiled")
  reportsAgainst       Report[]            @relation("ReportsAgainst")
  otpCodes             OtpCode[]
  publicKeys           PublicKey[]

  @@index([expiresAt])
  @@index([imageVerifiedAt])
}

// Persists independently of User so that banning a guest still blocks
// re-verification after the guest account (and its data) is purged.
model BanRecord {
  id               String   @id @default(uuid())
  identifierHash   String   @unique // sha256(normalized email or phone)
  reason           String
  category         TicketCategory?
  createdAt        DateTime @default(now())

  @@index([identifierHash])
}

// Serverless functions share no in-memory state between invocations (and
// there's no guarantee two requests even hit the same instance), so the
// matching queue that used to be an in-memory array now lives here.
// api/routes/queue.js reads/writes this table transactionally.
model WaitingQueueEntry {
  id            String       @id @default(uuid())
  userId        String       @unique
  genderClaimed GenderClaim
  desiredGender String?      // 'ANY' | a GenderClaim value | null
  canFilter     Boolean      @default(false)
  createdAt     DateTime     @default(now())

  @@index([createdAt])
}

model OtpCode {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash    String   // never store the raw code
  purpose     String   @default("image_verification") // or "login"
  expiresAt   DateTime
  consumedAt  DateTime?
  attempts    Int      @default(0)
  createdAt   DateTime @default(now())

  @@index([userId, purpose])
}

// Client-generated X25519 public keys for E2E encryption (nacl.box).
// Private keys NEVER leave the client / are never sent to the server.
model PublicKey {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  publicKey String   // base64
  createdAt DateTime @default(now())

  @@index([userId])
}

model Conversation {
  id             String    @id @default(uuid())
  participantAId String
  participantA   User      @relation("ParticipantA", fields: [participantAId], references: [id], onDelete: Cascade)
  participantBId String
  participantB   User      @relation("ParticipantB", fields: [participantBId], references: [id], onDelete: Cascade)
  createdAt      DateTime  @default(now())
  endedAt        DateTime?

  messages       Message[]
  reports        Report[]

  @@index([participantAId])
  @@index([participantBId])
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)

  // E2E encrypted payload — server only ever sees ciphertext.
  ciphertext     String
  nonce          String
  senderPubKey   String       // sender's public key used for this message, so the recipient can derive the shared secret

  kind           String       @default("text") // "text" | "image"
  image          Image?

  createdAt      DateTime     @default(now())

  @@index([conversationId])
}

model Image {
  id                String        @id @default(uuid())
  messageId         String        @unique
  message           Message       @relation(fields: [messageId], references: [id], onDelete: Cascade)

  // The file itself is stored encrypted-at-rest is out of scope for this
  // MVP; the file on disk is the ciphertext blob the client encrypted
  // before upload (server cannot render it without the recipient's key).
  storagePath       String
  viewMode          ImageViewMode

  uploadedAt        DateTime      @default(now())
  firstViewedAt     DateTime?
  viewedComplete    Boolean       @default(false) // true once the one-time/timed view has been consumed by the recipient

  deletedByUser     Boolean       @default(false)  // true if the recipient/sender explicitly deleted it
  deletedFromChatAt DateTime?     // soft-delete: hidden from chat UI (set by user action, or by the retention cron at +2 days)
  hardDeleteAt      DateTime?     // when the file+row will be permanently removed (immediately on user delete, else uploadedAt + 7 days)
  hardDeletedAt     DateTime?

  @@index([deletedFromChatAt])
  @@index([hardDeleteAt])
}

// Admin access to a not-yet-hard-deleted image is logged for accountability.
model AdminImageAccessLog {
  id         String   @id @default(uuid())
  imageId    String
  adminId    String
  reason     String?
  accessedAt DateTime @default(now())

  @@index([imageId])
}

model Report {
  id               String         @id @default(uuid())
  reporterId       String
  reporter         User           @relation("ReportsFiled", fields: [reporterId], references: [id], onDelete: Cascade)
  reportedUserId   String
  reportedUser     User           @relation("ReportsAgainst", fields: [reportedUserId], references: [id], onDelete: Cascade)
  conversationId   String?
  conversation     Conversation?  @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  category         TicketCategory
  description      String
  status           TicketStatus   @default(OPEN)

  assignedAdminId  String?
  resolutionNote   String?

  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([status])
  @@index([reportedUserId])
}
