# Copy to .env for local dev. On Vercel, set these as Project Environment
# Variables instead (Settings → Environment Variables) — Vercel injects
# them into the function at runtime; it doesn't read this file.

# --- Database (Neon Postgres) ---
# Use Neon's POOLED connection string (the one with "-pooler" in the
# hostname) for this single variable — it's used both at runtime
# (server/src/db.js, a plain PrismaClient) and for `prisma migrate`.
# `neon connection-string <branch> --pooled` prints it.
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/tinytalks?sslmode=require"

PORT=4000
CLIENT_ORIGIN="http://localhost:5173"

JWT_SECRET="replace-with-a-long-random-string"
ADMIN_BOOTSTRAP_EMAIL="admin@tinytalks.live"
ADMIN_BOOTSTRAP_PASSWORD="change-me-immediately"

# --- Realtime (Pusher Channels, replaces Socket.io) ---
# Free "Sandbox" plan is enough for an MVP: pusher.com → Channels → create
# an app → these four values are on the app's "App Keys" tab.
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER="us2"

# --- Object storage (Vercel Blob, replaces local disk) ---
# Vercel sets BLOB_READ_WRITE_TOKEN automatically once you attach a Blob
# store to the project (Storage tab → Create Database → Blob). For local
# dev, run `vercel env pull` to copy it here, or create a store and copy
# the token manually.
BLOB_READ_WRITE_TOKEN=

# --- Scheduled retention job (Vercel Cron, replaces node-cron) ---
# Any long random string. Set the SAME value as a Vercel env var — Vercel
# automatically sends it as `Authorization: Bearer <value>` when it calls
# /api/cron/retention on schedule (see vercel.json).
CRON_SECRET="replace-with-a-long-random-string"

# --- Email OTP (free, in-house) ---
# Any SMTP works. For local/dev with zero setup, leave SMTP_HOST unset and
# the mailer will fall back to an auto-created Ethereal test inbox
# (nodemailer's free fake-SMTP sandbox) and print a preview URL to the
# server console instead of sending a real email.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="tinytalks.live <no-reply@tinytalks.live>"

# --- Facial age-estimation vendor (image-sharing gate) ---
# This is left as an integration point on purpose. tinytalks does not
# collect government ID anywhere. Wire up a facial age-estimation +
# liveness vendor (e.g. Yoti Age Scan, Persona, Veriff, Incode) here.
# Until a real AGE_ESTIMATION_API_KEY is set, the adapter runs in
# "sandbox" mode: it does NOT verify anything and always returns
# not-verified, so image sharing stays safely disabled by default.
AGE_ESTIMATION_PROVIDER="sandbox"
AGE_ESTIMATION_API_KEY=
AGE_ESTIMATION_API_URL=
# Conservative threshold: treat estimated age below this as failing,
# to absorb the vendor's margin of error around the 18 line.
AGE_ESTIMATION_MIN_AGE=23
